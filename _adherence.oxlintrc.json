{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Kumbh Sans))/i]",
        "message": "Font not provided by the design system. Available: Kumbh Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatExchange'] > JSXAttribute > JSXIdentifier[name!=/^(?:messages|animate|style|key|ref|className|style|children)$/]",
        "message": "<ChatExchange> doesn't accept that prop. Declared props: messages, animate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FAQAccordion'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<FAQAccordion> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|style|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: icon, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FinePrint'] > JSXAttribute > JSXIdentifier[name!=/^(?:align|children|style|key|ref|className|style|children)$/]",
        "message": "<FinePrint> doesn't accept that prop. Declared props: align, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FinePrint'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<FinePrint> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Overline'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|children|style|key|ref|className|style|children)$/]",
        "message": "<Overline> doesn't accept that prop. Declared props: color, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|disclaimer|style|key|ref|className|style|children)$/]",
        "message": "<PageFooter> doesn't accept that prop. Declared props: logo, disclaimer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|cta|href|style|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: logo, cta, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|period|normal|bullets|cta|href|finePrint|onCta|style|key|ref|className|style|children)$/]",
        "message": "<PriceCard> doesn't accept that prop. Declared props: price, period, normal, bullets, cta, href, finePrint, onCta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyCTABar'] > JSXAttribute > JSXIdentifier[name!=/^(?:cta|href|showAfter|style|key|ref|className|style|children)$/]",
        "message": "<StickyCTABar> doesn't accept that prop. Declared props: cta, href, showAfter, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:photo|name|detail|quote|style|key|ref|className|style|children)$/]",
        "message": "<TestimonialCard> doesn't accept that prop. Declared props: photo, name, detail, quote, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustpilotBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:rating|count|style|key|ref|className|style|children)$/]",
        "message": "<TrustpilotBadge> doesn't accept that prop. Declared props: rating, count, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UrgencyBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<UrgencyBadge> doesn't accept that prop. Declared props: children, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
